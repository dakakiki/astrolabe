# AstroLabe on the production server (deploy/files/env.template → .env, written once by
# `provision.sh app`). Table and reasons: docs/deployment.md, "Aplikacija — .env na serveru".
# Secrets (APP_KEY, DB_PASSWORD, BACKUP_KEY, VAPID keys) are generated on the server;
# MAIL_PASSWORD is typed in by the owner: bash deploy/bin/set-env.sh --secret MAIL_PASSWORD
# Other values: bash deploy/bin/set-env.sh KEY=value (it also refreshes the config cache).

APP_NAME=AstroLabe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__APP_HOST__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__DB_NAME__
DB_USERNAME=__DB_USER__
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# The app's own host only, never .astrolabe.online (the WordPress site lives there).
SESSION_DOMAIN=__APP_HOST__
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=__APP_HOST__

PORTAL_DOMAIN=__PORTAL_HOST__
PORTAL_URL=https://__PORTAL_HOST__
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# The Webhosting mailbox, port 587 with STARTTLS (the cloud server cannot send on 25 or 465).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@astrolabe.online
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
PLACES_SOURCE=all

EPHEMERIS_ENGINE=swiss
SWETEST_PATH=__SWISSEPH_DIR__/swetest
EPHEMERIS_PATH=__SWISSEPH_DIR__/ephe

ATTACHMENTS_DISK=attachments
ATTACHMENTS_MAX_MB=100

# "invite" while only the developer uses the server (before the licence and the trial with
# billing); "open" on launch day (docs/deployment.md, "Puštanje").
REGISTRATION_MODE=invite
INVITATION_DAYS=14
REGISTRATION_PER_IP_HOUR=5

OPERATOR_EMAIL=
SUPPORT_EMAIL=
ADMIN_IDLE_MINUTES=30
ADMIN_CONFIRM_SECONDS=900

RATE_LIMIT_API=300
RATE_LIMIT_ENGINE=40

RETENTION_DELETED_DAYS=30
RETENTION_AUDIT_LOG_MONTHS=12
PRACTICE_DELETION_DAYS=30
EXPORT_LINK_HOURS=24
EXPORT_KEEP_DAYS=7

# Keep a copy of BACKUP_KEY and APP_KEY off this server (the owner's password manager).
BACKUP_KEY=
BACKUP_KEEP=14
BACKUP_DUMP_BINARY=mariadb-dump
BACKUP_CLIENT_BINARY=mariadb
BACKUP_OFFSITE_MARKER=
