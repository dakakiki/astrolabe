# AstroLabe (deploy/files/php/logrotate) → /etc/logrotate.d/php__PHP_VERSION__-fpm
# Server error logs are kept 14 days (Privacy Policy), not Ubuntu's 12 weeks.
/var/log/php__PHP_VERSION__-fpm.log {
	daily
	rotate 14
	missingok
	notifempty
	compress
	delaycompress
	postrotate
		if [ -x /usr/lib/php/php__PHP_VERSION__-fpm-reopenlogs ]; then
			/usr/lib/php/php__PHP_VERSION__-fpm-reopenlogs;
		fi
	endscript
}
