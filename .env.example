APP_NAME=AstroLabe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://dev.lcl.astrolabe.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=astrolabe_online__10_2026
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=dev.lcl.astrolabe.online
SANCTUM_STATEFUL_DOMAINS=dev.lcl.astrolabe.online

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Reminders and other email go through the queue. Production needs a running worker
# (php artisan queue:work, under systemd or Supervisor) and cron running
# php artisan schedule:run every minute.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Locally mail is written to storage/logs/laravel.log. Production sends through the
# domain's Webhosting mailbox: MAIL_MAILER=smtp, MAIL_PORT=587 (STARTTLS; the cloud server
# cannot send on 25 or 465), that mailbox's username and password, MAIL_FROM_ADDRESS = the
# mailbox, SPF/DKIM/DMARC on the domain (docs/deployment.md). Check it with "Send a test
# email" in Settings → Notifications.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@astrolabe.online"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
PLACES_SOURCE=all

EPHEMERIS_ENGINE=swiss
# SWETEST_PATH=/usr/local/bin/swetest
# EPHEMERIS_PATH=/var/lib/swisseph/ephe

# Private storage for client files: the server's own disk for now (docs/deployment.md);
# an S3-compatible bucket later.
ATTACHMENTS_DISK=attachments
ATTACHMENTS_MAX_MB=100

# Closed beta: accounts only through `php artisan invitations:send` ("open" = anyone).
REGISTRATION_MODE=invite
INVITATION_DAYS=14

# Failing health checks and server errors are emailed here (empty = no emails).
OPERATOR_EMAIL=

# The operator's admin (`php artisan admin:create <email>`): its session ends after this many
# quiet minutes; account-help actions ask for the password again after this many seconds.
ADMIN_IDLE_MINUTES=30
ADMIN_CONFIRM_SECONDS=900
# Named in the emails astrologers get about their account (defaults to OPERATOR_EMAIL).
SUPPORT_EMAIL=

# Requests per minute and person; "engine" = charts, transits, synastry, sky, dashboard.
RATE_LIMIT_API=300
RATE_LIMIT_ENGINE=40

# Retention (`php artisan data:prune`, nightly): deleted items stay restorable this many
# days, then go for good (files from the disk too); audit log in months; a practice
# scheduled for deletion can be cancelled for PRACTICE_DELETION_DAYS.
RETENTION_DELETED_DAYS=30
RETENTION_AUDIT_LOG_MONTHS=12
PRACTICE_DELETION_DAYS=30
# The emailed export link works for EXPORT_LINK_HOURS; the export is deleted after EXPORT_KEEP_DAYS.
EXPORT_LINK_HOURS=24
EXPORT_KEEP_DAYS=7

# Encrypted backups (`php artisan backup:run`, nightly once a key is set). Make the key with
# `php artisan backup:key` and keep a copy away from the server: without it no backup can be read.
BACKUP_KEY=
BACKUP_KEEP=14
# The MariaDB tools (on Windows give the full path to mariadb-dump.exe and mariadb.exe).
BACKUP_DUMP_BINARY=mariadb-dump
BACKUP_CLIENT_BINARY=mariadb
